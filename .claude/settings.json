{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PROJECT_DIR:-.}/tools/hooks/session_start.py\"",
            "timeout": 60,
            "statusMessage": "Синхронізую стан майстерні з GitHub..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PROJECT_DIR:-.}/tools/hooks/car_context.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
